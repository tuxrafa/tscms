# Identidade do produto. Trocar estes valores não exige mudança de esquema.
PRODUCT_CODE=tscms
PRODUCT_NAME=TSCMS

NODE_ENV=development
API_HOST=0.0.0.0
API_PORT=3000
AUTHOR_ORIGIN=http://127.0.0.1:5173
PUBLIC_BASE_URL=http://127.0.0.1:3000
RENDERER_PORT=3001

DATABASE_URL=postgresql://tscms:tscms@127.0.0.1:5432/tscms
REDIS_URL=redis://127.0.0.1:6379

# Segredo de desenvolvimento. Substitua fora da máquina local.
JWT_SECRET=dev-only-change-me-please-32chars
TOKEN_TTL=12h

# Armazenamento local. Para S3 compatível, preencha o bloco abaixo.
MEDIA_ROOT=./data/media
PUBLISH_ROOT=./data/published

# S3_ENDPOINT=http://127.0.0.1:9000
# S3_BUCKET=tscms
# S3_ACCESS_KEY_ID=tscms
# S3_SECRET_ACCESS_KEY=tscms-secret
# S3_REGION=us-east-1

# OpenTelemetry. Sem endpoint, a API segue só com logs estruturados.
# OTEL_EXPORTER_OTLP_ENDPOINT=http://127.0.0.1:4318
# OTEL_SERVICE_NAME=tscms-api

DEMO_EMAIL=editor@example.com
DEMO_PASSWORD=demo-password-change-me
DEMO_SITE_KEY=revista-demonstracao
